\name{mdeinR-package}
\alias{mdeinR-package}
\alias{mdeinR}
\docType{package}
\title{mdeinR: Memorable Dining Experience Text Analysis}
\description{
Provides tools to detect and score the five dimensions of the Memorable
Dining Experience (MDE) framework — sensory, affect, behavioral, social,
and intellectual — from free-text restaurant reviews. The package is fully
self-contained with a built-in sentence tokeniser, valence-shifter table,
and validated MDE lexicon of 324 words.
}
\references{
Vajpai, G. N., Webb, T., & Beldona, S. (2025). Designing a memorable
dining experience lexicon based on theory and text mining.
\emph{International Journal of Hospitality Management}, 130, 104245.
\doi{10.1016/j.ijhm.2025.104245}
}
